# Environment / secrets
.env
.env.*
!.env.example

# Credential and key material, scoped to data files on purpose. Bare
# *token* / *secret* globs also hide source such as SessionTokenStore.swift,
# and an ignored source file is invisible to Git instead of showing as untracked.
*.p8
*.p12
*.mobileprovision
*credential*.json
*credential*.txt
*secret*.json
*token*.json
*token*.csv

# Character.AI investigation material
*.har
*.HAR

# Local request / reverse-engineering dumps
request-dumps/
har/
captures/

# Local configuration
*.local
*.local.*

# Local data and scratch material
/screenshots-raw/
/private/
/scratch/
/captures/
/exports/
*.sqlite
*.sqlite3
*.db
FIXES_PROGRESS.md
CharacterSearchAuthDiagnostic.swift

# Audit and diagnostic output: timings, traces, probe dumps and snapshots.
# These are regenerated locally and never belong in the repository.
*.trace
*.jsonl
*.profraw
*.patch
*.orig
*.rej
/audit-*/
*-audit/
/measurements/

# Audit reports stay on this machine. They record unfixed security and
# privacy gaps, which does not belong in the published repository.
# Covers AUDIT.md, PERFORMANCE_AUDIT.md and LOADING_AND_CACHE_AUDIT.md.
/*AUDIT*.md

